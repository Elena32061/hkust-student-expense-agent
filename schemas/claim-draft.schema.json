{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/hkust-student-expense-agent/claim-draft.schema.json",
  "title": "Claim Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "line_items",
    "open_questions",
    "summary"
  ],
  "properties": {
    "source_request_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Extraction request ID assigned by the runner."
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt_ids",
          "expense_type",
          "date_from",
          "date_to",
          "currency",
          "amount",
          "business_purpose",
          "particular",
          "justification",
          "attachments",
          "confidence",
          "review_notes"
        ],
        "properties": {
          "receipt_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "expense_type": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S",
            "description": "Use null when unknown; do not invent a value."
          },
          "date_from": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Real calendar date in YYYY-MM-DD, or null when unknown."
          },
          "date_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Real calendar date in YYYY-MM-DD, or null when unknown."
          },
          "currency": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{3}$"
          },
          "amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Receipt amount without rounding; null when unknown."
          },
          "business_purpose": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S",
            "description": "Use null when unknown; do not invent a value."
          },
          "particular": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S",
            "description": "Use null when unknown; do not invent a value."
          },
          "justification": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S",
            "description": "Use null when unknown; do not invent a value."
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Exact original request paths for supporting receipt_ids."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "review_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimated_total_by_currency",
        "notes"
      ],
      "properties": {
        "estimated_total_by_currency": {
          "type": "array",
          "description": "One entry per known line-item currency. Unknown-currency items are unresolved and omitted. Complete currency totals must match the line-item sum; null totals are required only when a corresponding line-item amount is null. Arithmetic checks are enforced by the shared validator.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "currency",
              "total"
            ],
            "properties": {
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "total": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
